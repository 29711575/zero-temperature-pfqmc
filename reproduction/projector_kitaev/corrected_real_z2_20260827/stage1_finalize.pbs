#!/bin/bash
#PBS -N real_z2_stage1
#PBS -q workq
#PBS -l nodes=1:ppn=1
#PBS -l mem=4gb
#PBS -l walltime=01:00:00
#PBS -j oe
base=/home/sunxr/new-pfqmc-fix-real-z2-and-raw-checker/reproduction/projector_kitaev/corrected_real_z2_20260827
source /etc/profile >/dev/null 2>&1
module load anaconda3 >/dev/null 2>&1
set -eo pipefail
cd "$base"
python3 aggregate.py > stage1_summary.json
n=$(python3 -c 'import csv; print(sum(1 for _ in csv.DictReader(open("spot_manifest.csv"))))')
if [ "$n" -gt 0 ]; then
  qsub -J "0-$((n-1))" spot_replay.pbs > spot_job_id.txt
else
  printf 'none\n' > spot_job_id.txt
fi

#!/usr/bin/env bash
#PBS -N pfqmc_proj_theta
#PBS -q workq
#PBS -J 0-19
#PBS -l nodes=1:ppn=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?submit qsub from reproduction/projector_kitaev}"
task_id=${PBS_ARRAY_INDEX:?PBS_ARRAY_INDEX is unavailable}
row=$(sed -n "$((task_id + 2))p" manifest_small.csv | tr -d '\r')
[[ -n "$row" ]] || { echo "missing manifest row $task_id" >&2; exit 2; }
IFS=, read -r manifest_id L theta beta_trial dt V delta mu boundary hs_scheme seed burn measurements threads output_dir <<< "$row"
[[ "$manifest_id" == "$task_id" ]] || { echo "manifest mismatch" >&2; exit 2; }
[[ -x ./projector_driver ]] || { echo "projector_driver is unavailable" >&2; exit 2; }
mkdir -p "$output_dir"
if [[ -e "$output_dir/result.json" ]]; then
  echo "existing output retained: $output_dir/result.json" >&2
  exit 2
fi
set +u
source /opt/ohpc/pub/apps/intel/oneapi/setvars.sh >/dev/null
set -u
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
started=$(date +%s)
set +e
./projector_driver "$L" "$theta" "$beta_trial" "$dt" "$V" "$delta" "$mu" \
  "$boundary" "$hs_scheme" "$seed" "$burn" "$measurements" "$threads" \
  >"$output_dir/result.json" 2>"$output_dir/stderr.log"
rc=$?
set -e
ended=$(date +%s)
printf 'status=%s\nexit_code=%s\njob_id=%s\nwrapper_seconds=%s\n' \
  "$([[ $rc -eq 0 ]] && echo complete || echo failed)" "$rc" "${PBS_JOBID:-unknown}" "$((ended-started))" \
  >"$output_dir/status.txt"
exit "$rc"

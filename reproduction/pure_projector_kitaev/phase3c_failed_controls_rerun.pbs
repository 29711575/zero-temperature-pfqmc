#!/usr/bin/env bash
#PBS -N pure_p3c_rerun
#PBS -J 0-9
#PBS -l select=1:ncpus=1:mem=32gb
#PBS -l walltime=120:00:00
#PBS -j oe

set -euo pipefail
export LC_ALL=C LANG=C OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
source /opt/ohpc/pub/apps/intel/oneapi/setvars.sh >/dev/null 2>&1
work=/home/sunxr/pure-state-projector-phase3c-trust-init
manifest="$work/reproduction/pure_projector_kitaev/phase3c_rerun_manifest.csv"
root="$work/reproduction/pure_projector_kitaev/phase3c_rerun_results"
run=${PBS_ARRAY_INDEX:?missing PBS_ARRAY_INDEX}
line=$(sed -n "$((run+2))p" "$manifest")
IFS=, read -r manifest_run original_task L V boundary hs seed trial_mu splitting parity role initialization_policy <<<"$line"
test "$manifest_run" = "$run"
result="$root/run_$(printf '%02d' "$run")_original_$(printf '%02d' "$original_task")"
if test -e "$result"; then
  echo "refusing to overwrite existing result directory: $result" >&2
  exit 70
fi
mkdir -p "$result"
cd "$work"
exe=build_phase3c/pure_projector_driver
source_commit=$(git rev-parse HEAD)
exe_sha=$(sha256sum "$exe" | awk '{print $1}')
set +e
"$exe" --L "$L" --V "$V" --t 1 --delta 1 --mu 0 --theta "$L" --dt 0.1 \
  --boundary "$boundary" --hs-scheme "$hs" --trial-t 1 --trial-delta 1 \
  --trial-mu "$trial_mu" --trial-parity "$parity" --edge-splitting "$splitting" \
  --burn 1000 --measurements 2000 --seed "$seed" --stabilization-block 8 \
  --retained "$result/retained.csv" --audit-interval 100 --walker-mode fast-strict \
  --initialization-policy "$initialization_policy" \
  --source-commit "$source_commit" --executable-sha256 "$exe_sha" \
  >"$result/result.jsonl" 2>"$result/stderr.log"
code=$?
set -e
printf '%s\n' "$code" >"$result/exit_code.txt"
exit "$code"

#!/usr/bin/env bash
#PBS -N pure_phase3b
#PBS -J 0-35
#PBS -l select=1:ncpus=1:mem=32gb
#PBS -l walltime=72:00:00
#PBS -j oe

set -euo pipefail
export LC_ALL=C LANG=C OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
source /opt/ohpc/pub/apps/intel/oneapi/setvars.sh >/dev/null 2>&1
work=/home/sunxr/pure-state-projector-phase3b
root="$work/reproduction/pure_projector_kitaev/phase3b_benchmark"
manifest="$root/manifest.csv"
index=${PBS_ARRAY_INDEX:?missing PBS_ARRAY_INDEX}
line=$(sed -n "$((index+2))p" "$manifest")
IFS=, read -r task L V boundary hs seed trial_mu splitting parity <<<"$line"
test "$task" = "$index"
result="$root/task_$(printf '%02d' "$index")"
mkdir -p "$result"
cd "$work"
exe=reproduction/pure_projector_kitaev/build_phase3b/pure_projector_driver
source_commit=$(git rev-parse HEAD)
exe_sha=$(sha256sum "$exe" | awk '{print $1}')
set +e
"$exe" --L "$L" --V "$V" --t 1 --delta 1 --mu 0 --theta "$L" --dt 0.1 \
  --boundary "$boundary" --hs-scheme "$hs" --trial-t 1 --trial-delta 1 \
  --trial-mu "$trial_mu" --trial-parity "$parity" --edge-splitting "$splitting" \
  --burn 1000 --measurements 2000 --seed "$seed" --stabilization-block 8 \
  --run-units sweeps --measurement-stride 1 \
  --retained "$result/retained.csv" --audit-interval 100 --walker-mode fast-strict \
  --source-commit "$source_commit" --executable-sha256 "$exe_sha" \
  >"$result/result.jsonl" 2>"$result/stderr.log"
code=$?
set -e
printf '%s\n' "$code" >"$result/exit_code.txt"
exit "$code"
